# --- Database ---
# Optional. If unset, the app uses an embedded in-memory Postgres (PGlite)
# seeded with starter resources — perfect for local dev and previews.
# DATABASE_URL=postgres://user:password@localhost:5432/studyhub

# --- AI Agent: phone calls (Twilio) ---
# Optional until you want the agent to ring your phone. Get these from
# https://console.twilio.com after creating an account.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# A Twilio number in E.164 format:
# TWILIO_FROM_NUMBER=+12025550123

# --- AI Agent: smarter replies (optional) ---
# Any OpenAI-compatible chat completions endpoint. If unset, a built-in
# offline brain handles answers (study Q&A, maths, conversions, tips…).
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
